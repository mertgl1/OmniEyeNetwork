# Copy to .env, generate fresh secrets, and replace the database credentials.
PROJECT_NAME="OmniEyeNetwork"
ENVIRONMENT="development"
DEBUG=False
API_V1_STR="/api/v1"

# Database
DB_HOST=mariadb
DB_PORT=3306
DB_USER=omnieye_user
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=omnieye_db
MARIADB_ROOT_PASSWORD=replace-with-a-unique-root-password

# Optional production Compose secret-file paths (never commit the referenced files).
# MARIADB_ROOT_PASSWORD_SECRET_FILE=./secrets/mariadb_root_password
# DB_PASSWORD_SECRET_FILE=./secrets/db_password
# VAULT_SECRET_KEY_SECRET_FILE=./secrets/vault_key
# JWT_SECRET_KEY_SECRET_FILE=./secrets/jwt_secret
# TLS_CERTIFICATE_FILE=./certs/fullchain.pem
# TLS_PRIVATE_KEY_FILE=./certs/private.key

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Europe/Istanbul
NORNIR_NUM_WORKERS=20
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_VERSIONS=10

# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local-only development mode. Set both to false for real inventory devices.
AD_MOCK_MODE=true
NETWORK_SIMULATION_MODE=true

# Active Directory (required when AD_MOCK_MODE=false)
AD_SERVER=ldaps://ad.example.local
AD_DOMAIN=example.local
AD_BASE_DN=DC=example,DC=local
AD_USE_SSL=true
AD_GROUP_ADMIN=Network_Admins
AD_GROUP_OPERATOR=Network_Operators
AD_GROUP_VIEWER=Network_Viewers
SSH_STRICT_HOST_KEY_CHECKING=false
SSH_KNOWN_HOSTS_FILE=./ssh/known_hosts.example

# Browser origins and host ports
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT_HOST=3306
REDIS_PORT_HOST=6379
